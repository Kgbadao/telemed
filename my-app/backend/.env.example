# Backend. Copy to .env — never commit the real .env file.

PORT=5000

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Firebase service account JSON, pasted as ONE LINE (Firebase console ->
# Project settings -> Service accounts -> Generate new private key).
# On Render, add it as an environment variable. Do NOT save the .json file in the repo.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# OAuth client ID used to verify Google sign-in tokens
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Deployed frontend origin allowed by CORS (localhost:5173 and :3000 are already allowed)
FRONTEND_URL=https://your-frontend.vercel.app
